# Ключ авторизации GigaChat (личный кабинет разработчика → получить ключ).
# В код ключ не записывайте: приложение читает только переменные окружения.
GIGACHAT_CREDENTIALS=

# Область доступа. Для личного кабинета обычно GIGACHAT_API_PERS.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Имя модели. Список доступных моделей зависит от подключённого тарифа.
GIGACHAT_MODEL=GigaChat-2

# Проверка TLS включена. Для сертификата НУЦ Минцифры укажите файл:
# GIGACHAT_CA_BUNDLE_FILE=/путь/к/russian_trusted_root_ca.crt
GIGACHAT_VERIFY_SSL_CERTS=true

# Только для локальной отладки, если сертификат ещё не установлен:
# GIGACHAT_VERIFY_SSL_CERTS=false

# Необязательно. Раскомментируйте, если нужен готовый access token вместо ключа.
# GIGACHAT_ACCESS_TOKEN=

# Таймаут одного запроса, секунды.
GIGACHAT_TIMEOUT=30
